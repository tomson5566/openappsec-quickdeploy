NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
APPSEC_VERSION=latest

## 三个核心数据目录（首次运行前需手动创建）
APPSEC_CONFIG=./appsec-config
APPSEC_DATA=./appsec-data
APPSEC_LOGS=./appsec-logs
APPSEC_LOCALCONFIG=./appsec-localconfig

## 本地声明式策略，false=使用localconfig/下的yaml（推荐）
APPSEC_AUTO_POLICY_LOAD=false

## 高级ML模型包路径
APPSEC_MODEL=./images/open-appsec-advanced-model.tgz

## HTTPS代理（直连无需填写）
APPSEC_HTTPS_PROXY=

## 学习数据存储（standalone模式使用，可不挂载）
APPSEC_SMART_SYNC_STORAGE=./appsec-smartsync-storage

## nginx配置文件路径
NGINX_CONFIG=./nginx-config

## Cloud注册Token（留空=独立模式，不连云端）
## 如需连接到 https://my.openappsec.io，在下方填写Profile Token
APPSEC_AGENT_TOKEN=

## 勿改动
COMPOSE_PROFILES=
